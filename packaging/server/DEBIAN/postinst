#!/bin/sh
set -eu

if ! getent passwd tuxindrive-server >/dev/null; then
  install -d -m 0750 /var/lib/tuxindrive-server
  adduser --system --group --home /var/lib/tuxindrive-server \
    --no-create-home --disabled-login tuxindrive-server
fi
install -d -m 0750 -o root -g tuxindrive-server /etc/tuxindrive-server
install -d -m 0750 -o tuxindrive-server -g tuxindrive-server /var/lib/tuxindrive-server
if [ -L /var/lib/tuxindrive-server-admin ] || { [ -e /var/lib/tuxindrive-server-admin ] && [ ! -d /var/lib/tuxindrive-server-admin ]; }; then
  echo 'Refusing unsafe bootstrap administration directory' >&2
  exit 1
fi
install -d -m 0700 -o root -g root /var/lib/tuxindrive-server-admin
if [ -L /etc/tuxindrive-server/server.json ]; then
  echo 'Refusing unsafe symlink at /etc/tuxindrive-server/server.json' >&2
  exit 1
fi
if [ ! -f /etc/tuxindrive-server/server.json ]; then
  /usr/bin/tuxindrive-server init \
    --config /etc/tuxindrive-server/server.json \
    --state /var/lib/tuxindrive-server \
    --token-file /var/lib/tuxindrive-server-admin/bootstrap-token
fi
test -f /etc/tuxindrive-server/server.json
chown root:tuxindrive-server /etc/tuxindrive-server/server.json
chmod 0640 /etc/tuxindrive-server/server.json
chown tuxindrive-server:tuxindrive-server /var/lib/tuxindrive-server
/usr/bin/tuxindrive-server admin migrate-bootstrap-token
if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
fi
printf '%s\n' \
  'TuxInDrive Server installed. Read the initial API token with:' \
  '  sudo tuxindrive-server admin read-bootstrap-token' \
  'Store it in the client Settings, then securely delete that bootstrap file.' \
  'Start the server with: sudo systemctl enable --now tuxindrive-server'
